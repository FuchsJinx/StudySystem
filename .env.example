# Copy to .env for local overrides (never commit .env)
JWT_SECRET=dev-only-change-me-unirate-jwt-secret-32+
# Public frontend URL used in verification e-mail links
APP_URL=http://localhost
# LLM (OpenAI-compatible). Empty values = deterministic demo mode.
LLM_API_KEY=
LLM_BASE_URL=
# Optional Telegram bot token; empty = mock transport in logs
TELEGRAM_BOT_TOKEN=
